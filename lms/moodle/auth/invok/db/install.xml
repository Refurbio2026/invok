<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="auth/invok/db" VERSION="20261110" COMMENT="XMLDB file for Moodle auth/invok"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="auth_invok_used" COMMENT="One-time login links that were already used (replay protection)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jti" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Unique id of the link"/>
        <FIELD NAME="timeexpires" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="jti" UNIQUE="true" FIELDS="jti"/>
        <INDEX NAME="timeexpires" UNIQUE="false" FIELDS="timeexpires"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
